{
  "name": "binopsy",
  "author": "Felix Boehm <me@feedic.com>",
  "version": "0.0.0",
  "description": "Typed binary codecs: compiled decoders and encoders, partial decoding and streams",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "mocha",
    "lint": "eslint . && tsc && npm run build && tsc -p test/package",
    "format": "prettier --write ."
  },
  "keywords": [
    "binary",
    "serializer",
    "encode",
    "pack",
    "struct",
    "buffer",
    "bit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://github.com/fb55/binopsy.git"
  },
  "engines": {
    "node": ">=22.18"
  }
}
